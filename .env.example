# --- Server ---
PORT=3000
# Public https URL this server is reachable at (no trailing slash).
# Meta's webhook and the media links it fetches both go through this.
PUBLIC_BASE_URL=https://wa.yourdomain.com

# --- Meta app / webhook ---
# Any string you choose; you enter the same value in the Meta App dashboard
# when you set up the webhook subscription.
VERIFY_TOKEN=choose-a-long-random-string
# From Meta App dashboard > App settings > Basic > App secret.
# Used to verify each webhook call really came from Meta. Leave unset only
# for local testing — never leave it unset in production.
APP_SECRET=
GRAPH_API_VERSION=v21.0

# --- Number 1 (configure this one first) ---
NUMBER1_LABEL=Number 1 - Miami Beach Resort
NUMBER1_PHONE_NUMBER_ID=
NUMBER1_ACCESS_TOKEN=
# Optional per-number overrides (defaults are fine to start with):
# NUMBER1_DAILY_CAP=150
# NUMBER1_CONCURRENCY=3
# NUMBER1_SEND_DELAY_MS=1000

# --- Number 2 (leave blank until Number 1 is confirmed working) ---
NUMBER2_LABEL=Number 2 - Miami Beach Resort
NUMBER2_PHONE_NUMBER_ID=
NUMBER2_ACCESS_TOKEN=
# NUMBER2_DAILY_CAP=150
# NUMBER2_CONCURRENCY=3
# NUMBER2_SEND_DELAY_MS=1000
